# =============================================================================
# Patpat-MakeMoney โ€” environment template (TEAM SoT)
# =============================================================================
# Copy to `.env` on your machine (gitignored). Never commit real secrets.
# Local secrets folder (outside repo): %USERPROFILE%\Documents\Patpat-MakeMoney-secrets\
#
# Doctrine: paper / read-only first. Live gates default OFF / empty.
# Fill only what your lane needs. Leave unused keys blank.
# =============================================================================


# -----------------------------------------------------------------------------
# 0) Desk identity (non-secret)
# -----------------------------------------------------------------------------
PMM_DESK_NAME=Patpat-MakeMoney
PMM_OPERATOR=
# Local machine tag for logs (optional)
PMM_HOST_LABEL=


# -----------------------------------------------------------------------------
# 1) Live / safety gates (DEFAULT OFF โ€” blank or 0)
# -----------------------------------------------------------------------------
# Polymarket / legacy HL stack live execute
PMM_LIVE_OK=
# Future Bitkub live orders (paper path ignores)
PMM_BITKUB_LIVE_OK=
# Future Binance TH signed orders (public tape needs no key)
PMM_BINANCE_TH_LIVE_OK=
# Future Solana live / custody (P2 only after P0+P1 + explicit user OK)
PMM_SOL_LIVE_OK=

# Fixture / offline test gates (DEFAULT OFF โ€” tests only)
PMM_ARB_ALLOW_FIXTURE=
PMM_BASIS_ALLOW_FIXTURE=
PMM_BINANCE_TH_FIXTURE=


# -----------------------------------------------------------------------------
# 2) Binance TH (BNTH) โ€” api.binance.th ONLY (not binance.com)
# -----------------------------------------------------------------------------
# Public market data needs NO key today.
BINANCE_TH_API_BASE=https://api.binance.th
# Future signed / trade (leave blank until live gate + Thesis pass)
BINANCE_TH_API_KEY=
BINANCE_TH_API_SECRET=


# -----------------------------------------------------------------------------
# 3) Bitkub โ€” public ticker for paper; signed = future only
# -----------------------------------------------------------------------------
BITKUB_API_BASE=https://api.bitkub.com
BITKUB_API_KEY=
BITKUB_API_SECRET=


# -----------------------------------------------------------------------------
# 4) DEX research โ€” 1inch (read-only quotes; optional key)
# -----------------------------------------------------------------------------
# Portal / Spot Price Bearer. Without key: no silent fixture on money-path.
ONEINCH_API_KEY=


# -----------------------------------------------------------------------------
# 5) Solana / Jupiter โ€” research tape (quote-only; no sign/send)
# -----------------------------------------------------------------------------
# Optional Portal key (x-api-key). Keyless OK at low RPS.
# https://developers.jup.ag/portal
JUPITER_API_KEY=
JUPITER_API_BASE=https://api.jup.ag

# Desk wallet PUBKEY only (safe to share). Never put seed/private key in .env.
# Example desk pubkey (replace if you rotate):
PMM_SOL_DESK_PUBKEY=7W3SPbRcGD1GJPpafEYhgduaMxLpmHBG9KGqytqZEhHf

# Optional public Solana JSON-RPC (balance probe). Default: mainnet-beta public.
PMM_SOL_RPC_URL=

# Local path to secret material OUTSIDE the repo (not wired for live yet).
# Windows example:
# PMM_SOL_SECRETS_DIR=C:\Users\<you>\Documents\Patpat-MakeMoney-secrets
PMM_SOL_SECRETS_DIR=
# Do NOT put mnemonic / private key values in this file.
# Team ops authority: see docs/SOLANA_CUSTODY.md


# -----------------------------------------------------------------------------
# 6) Polymarket + Hyperliquid (legacy / optional โ€” geo may block TH)
# -----------------------------------------------------------------------------
SYMBOL=BTC
GAMMA_BASE_URL=https://gamma-api.polymarket.com
PM_CLOB_BASE=https://clob.polymarket.com
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
PM_MARKET_SLUG=

# Execution safety (paper defaults conservative)
PM_MAX_NOTIONAL_USD=4
PM_ORDER_TYPE=FAK
PM_CLOSE_ORDER_TYPE=FAK
PM_EXEC_TIMEOUT_SEC=45
PM_LOOP_SEC=60

# Auth โ€” REQUIRED only for live execution (leave blank for paper)
PM_PRIVATE_KEY=
PM_FUNDER=
PM_ADDRESS=
PM_SIGNATURE_TYPE=2
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# Entry quality
PM_ENTRY_PRICE_MIN=0.03
PM_ENTRY_PRICE_MAX=0.97
PM_MAX_SPREAD=0.03
PM_MIN_TOP_ASK_NOTIONAL_USD=20

# Exit triggers
PM_SL_PCT=0.35
PM_TP_PCT=0.25
PM_TRAIL_ARM_PCT=0.15
PM_TRAIL_GIVEBACK_PCT=0.08
PM_TIME_EXIT_SEC=90
PM_CLOSE_PRICE_BAND_PCT=0.03

# Vol-adaptive bands
PM_SL_BASE=0.30
PM_SL_VOL_MULT=220
PM_SL_MIN=0.20
PM_SL_MAX=0.50
PM_TP_BASE=0.20
PM_TP_VOL_MULT=180
PM_TP_MIN=0.12
PM_TP_MAX=0.45
PM_TRAIL_ARM_BASE=0.12
PM_TRAIL_ARM_VOL_MULT=120
PM_TRAIL_ARM_MIN=0.08
PM_TRAIL_ARM_MAX=0.35
PM_TRAIL_GIVEBACK_BASE=0.06
PM_TRAIL_GIVEBACK_VOL_MULT=70
PM_TRAIL_GIVEBACK_MIN=0.04
PM_TRAIL_GIVEBACK_MAX=0.20

# Close path robustness
PM_MIN_CLOSE_SHARES=0.001
PM_CLOSE_SIZE_STEP=0.0001
PM_CLOSE_IOC_PROBE_FRAC=0.30
PM_CLOSE_MIN_BOOK_DEPTH=1
PM_CLOSE_MAX_SPREAD=0.30
PM_CLOSE_DEFER_BASE_SEC=8
PM_CLOSE_DEFER_MAX_SEC=60
PM_MANUAL_ESCALATION_FAILS=3
PM_MANUAL_ESCALATION_DEBOUNCE_SEC=900

# Worker guards / heartbeat
PM_PENDING_TTL_SEC=180
PM_CLOSE_FAIL_WINDOW_MIN=15
PM_CLOSE_FAIL_THRESHOLD=6
PM_HEARTBEAT_INTERVAL_SEC=5
PM_AUTO_RESTORE_ALLOWANCE=1
PM_CLOSE_REQUIRE_ALLOWANCE_OK=0

# Paper sim helpers (legacy runners)
START_EQUITY=1000
BASE_RISK_FRAC=0.03


# -----------------------------------------------------------------------------
# 7) Team fill checklist (local .env)
# -----------------------------------------------------------------------------
# [ ] PMM_OPERATOR = your handle
# [ ] JUPITER_API_KEY = optional (Portal) for higher RPS on sol tape
# [ ] ONEINCH_API_KEY = optional for DEXโ’CEX arb quotes
# [ ] PMM_SOL_DESK_PUBKEY = desk wallet address (pubkey only)
# [ ] PMM_SOL_SECRETS_DIR = path outside repo (secrets never in git)
# [ ] BITKUB_* / BINANCE_TH_* signed = leave blank until live authorized
# [ ] All *_LIVE_OK = leave blank until explicit desk go
# [ ] PM_* auth = leave blank if Polymarket geo-blocked / unused