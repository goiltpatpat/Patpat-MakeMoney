# =============================================================================
# Patpat-MakeMoney — .env.local.example (machine overlay)
# =============================================================================
# Optional: copy to `.env.local` (gitignored via `.env.*`) for machine-only
# overrides. Prefer putting secrets in Documents\Patpat-MakeMoney-secrets\
# and referencing paths here — never paste mnemonics into git-tracked files.
#
# Load order (if your runner supports it): .env then .env.local overrides.
# =============================================================================

PMM_OPERATOR=
PMM_HOST_LABEL=

# Optional research keys (read-only)
JUPITER_API_KEY=
ONEINCH_API_KEY=

# Desk Solana pubkey (non-secret) + secrets directory pointer
PMM_SOL_DESK_PUBKEY=
PMM_SOL_SECRETS_DIR=

# Keep all live gates empty unless explicitly authorized
PMM_LIVE_OK=
PMM_BITKUB_LIVE_OK=
PMM_BINANCE_TH_LIVE_OK=
PMM_SOL_LIVE_OK=