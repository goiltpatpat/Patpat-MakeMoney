# =============================
# Polymarket HL Strategy config
# =============================

# --- Core market/source ---
SYMBOL=BTC
GAMMA_BASE_URL=https://gamma-api.polymarket.com
PM_CLOB_BASE=https://clob.polymarket.com
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz

# Optional: force a specific market slug (otherwise auto-resolve current 15m bucket)
PM_MARKET_SLUG=

# --- Execution safety ---
PM_MAX_NOTIONAL_USD=4
PM_ORDER_TYPE=FAK
PM_CLOSE_ORDER_TYPE=FAK
PM_EXEC_TIMEOUT_SEC=45
PM_LOOP_SEC=60

# --- Auth (REQUIRED for live execution) ---
PM_PRIVATE_KEY=
PM_FUNDER=
PM_ADDRESS=
PM_SIGNATURE_TYPE=2
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Entry quality filters ---
PM_ENTRY_PRICE_MIN=0.03
PM_ENTRY_PRICE_MAX=0.97
PM_MAX_SPREAD=0.03
PM_MIN_TOP_ASK_NOTIONAL_USD=20

# --- Exit trigger params ---
PM_SL_PCT=0.35
PM_TP_PCT=0.25
PM_TRAIL_ARM_PCT=0.15
PM_TRAIL_GIVEBACK_PCT=0.08
PM_TIME_EXIT_SEC=90
PM_CLOSE_PRICE_BAND_PCT=0.03

# --- Volatility-adaptive bands for position state builder ---
PM_SL_BASE=0.30
PM_SL_VOL_MULT=220
PM_SL_MIN=0.20
PM_SL_MAX=0.50
PM_TP_BASE=0.20
PM_TP_VOL_MULT=180
PM_TP_MIN=0.12
PM_TP_MAX=0.45
PM_TRAIL_ARM_BASE=0.12
PM_TRAIL_ARM_VOL_MULT=120
PM_TRAIL_ARM_MIN=0.08
PM_TRAIL_ARM_MAX=0.35
PM_TRAIL_GIVEBACK_BASE=0.06
PM_TRAIL_GIVEBACK_VOL_MULT=70
PM_TRAIL_GIVEBACK_MIN=0.04
PM_TRAIL_GIVEBACK_MAX=0.20

# --- Close path robustness ---
PM_MIN_CLOSE_SHARES=0.001
PM_CLOSE_SIZE_STEP=0.0001
PM_CLOSE_IOC_PROBE_FRAC=0.30
PM_CLOSE_MIN_BOOK_DEPTH=1
PM_CLOSE_MAX_SPREAD=0.30
PM_CLOSE_DEFER_BASE_SEC=8
PM_CLOSE_DEFER_MAX_SEC=60
PM_MANUAL_ESCALATION_FAILS=3
PM_MANUAL_ESCALATION_DEBOUNCE_SEC=900

# --- Worker guards ---
PM_PENDING_TTL_SEC=180
PM_CLOSE_FAIL_WINDOW_MIN=15
PM_CLOSE_FAIL_THRESHOLD=6

# --- Heartbeat / maintenance ---
PM_HEARTBEAT_INTERVAL_SEC=5
PM_AUTO_RESTORE_ALLOWANCE=1
PM_CLOSE_REQUIRE_ALLOWANCE_OK=0

# =============================
# Multi-venue Phase 1 (research / paper)
# =============================
# Optional 1inch Spot Price API (read-only quotes; never required for paper BTC tape)
# ONEINCH_API_KEY=

# Bitkub placeholders for a FUTURE live adapter (NOT used by paper skeleton)
# Live orders require PMM_BITKUB_LIVE_OK=1 in a future module — paper path ignores these.
# BITKUB_API_KEY=
# BITKUB_API_SECRET=
# BITKUB_API_BASE=https://api.bitkub.com
# PMM_BITKUB_LIVE_OK=


# Arb SCAN fixture gate (OFFLINE TESTS ONLY — default unset/off)
# PMM_ARB_ALLOW_FIXTURE=
# PMM_BINANCE_TH_FIXTURE=
